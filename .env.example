# 第一版网络 / 代币列表打包在 data/catalog/，不请求后台。
# 目录站以后再填：
# VITE_CATALOG_BASE_URL=

# EVM JSON-RPC。Infura 可选；连不上时钱包会自动改用公共节点
VITE_INFURA_API_KEY=

# Bitcoin Esplora API（默认 Blockstream 公共节点，无需 key）
VITE_BTC_MAINNET_API=https://blockstream.info/api
VITE_BTC_TESTNET_API=https://blockstream.info/testnet/api

# TRON HTTP API（默认 TronGrid 公共节点）
VITE_TRON_MAINNET_API=https://api.trongrid.io
VITE_TRON_TESTNET_API=https://nile.trongrid.io
VITE_TRONGRID_API_KEY=

# Solana JSON-RPC（默认官方公共节点，主网建议换成 Helius / QuickNode）
VITE_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# CoinGecko Demo API（资产总览法币折算，申请：https://www.coingecko.com/en/api）
VITE_COINGECKO_API_KEY=
